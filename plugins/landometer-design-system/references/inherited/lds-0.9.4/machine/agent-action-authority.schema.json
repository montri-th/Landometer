{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landometer.org/design-system/0.9.4/agent-action-authority.schema.1.3.json",
  "title": "Landometer agent action authority v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseRef", "authorityId", "artifactId", "actionId", "authorizedActorId", "authorizedActorClass", "inputSchemaRef", "inputSchemaSha256", "inputSchemaId", "allowedInputClassifications", "status", "policy", "authorizedOperations", "authorizedSideEffectClasses", "validity", "authorizedBy", "authorizedAt", "authorityEvidenceRef"],
  "properties": {
    "schemaVersion": { "const": "1.3" },
    "releaseRef": { "const": "v0.9.4-mp1" },
    "authorityId": { "$ref": "#/$defs/nonEmpty" },
    "artifactId": { "$ref": "#/$defs/nonEmpty" },
    "actionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "authorizedActorId": { "$ref": "#/$defs/nonEmpty" },
    "authorizedActorClass": { "enum": ["human_user", "authorized_agent"] },
    "inputSchemaRef": { "$ref": "#/$defs/safeRef" },
    "inputSchemaSha256": { "$ref": "#/$defs/sha256" },
    "inputSchemaId": { "$ref": "#/$defs/nonEmpty" },
    "allowedInputClassifications": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["public", "internal", "confidential", "restricted"] }
    },
    "status": { "const": "active" },
    "policy": { "enum": ["read_only", "confirm_before_commit", "owner_authorized"] },
    "authorizedOperations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["read", "inspect", "draft", "submit", "create", "save", "share", "download", "external_handoff", "confirm", "destructive"] }
    },
    "authorizedSideEffectClasses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["none", "reversible", "external", "costly", "irreversible", "destructive"] }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "expiresAt", "revocationRef", "revocationSha256", "revocationSchemaRef", "revocationAttestationRef", "revocationAttestationSha256"],
      "properties": {
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "revocationRef": { "$ref": "#/$defs/safeRef" },
        "revocationSha256": { "$ref": "#/$defs/sha256" },
        "revocationSchemaRef": { "const": "https://landometer.org/design-system/0.9.4/agent-action-revocation.schema.1.2.json" },
        "revocationAttestationRef": { "$ref": "#/$defs/safeRef" },
        "revocationAttestationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorizedBy": { "$ref": "#/$defs/nonEmpty" },
    "authorizedAt": { "type": "string", "format": "date-time" },
    "authorityEvidenceRef": { "$ref": "#/$defs/nonEmpty" }
  },
  "allOf": [
    {
      "if": { "properties": { "policy": { "const": "read_only" } }, "required": ["policy"] },
      "then": {
        "properties": {
          "authorizedOperations": { "items": { "enum": ["read", "inspect"] } },
          "authorizedSideEffectClasses": { "items": { "const": "none" } }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "safeRef": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
