        "destinations",
        "redaction",
        "failureBehavior"
      ],
      "properties": {
        "capability": {
          "const": "telemetry"
        },
        "events": {
          "$ref": "#/$defs/nonEmptyArray"
        },
        "consentPolicy": {
          "$ref": "#/$defs/stringOrObject"
        },
        "dataClassification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
