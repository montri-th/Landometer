          "pattern": "^(surface\\.canvas|surface\\.alt|surface\\.card|surface\\.raised|surface\\.soft|surface\\.blueTint|surface\\.beigeTint|brand\\.beige|brand\\.blue|atmosphere\\.ground\\.mist|atmosphere\\.measure\\.luminous|atmosphere\\.ground\\.current|atmosphere\\.measure\\.deep|surfaceAtmosphere\\.ground|surfaceAtmosphere\\.measure)(@(light|dark))?$",
          "description": "MOTIF-06 carrier id from motif-register.v0.9.4.json#/carrierPolicy/carriers; themed ids are checked per rendered theme; <id>@light|@dark paints that theme's value in both themes"
        },
        "variantDark": {
          "enum": [
            "quiet"
          ],
          "description": "MOTIF-06 theme swap: full in the light theme, quiet in the dark theme"
        },
        "hostSurfaceHex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "light": {
              "type": "string"
            },
            "dark": {
              "type": "string"
            }
          }
        },
        "measuredContrast": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}–[0-9]+\\.[0-9]{2}$"
            },
            "dark": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}–[0-9]+\\.[0-9]{2}$"
            }
          },
          "description": "weakest–strongest paint ratio from carrierPolicy.measured"
        },
        "contrastVerdict": {
          "enum": [
            "meaningCapable",
            "decorativeOnly",
            "invisible"
          ]
        },
        "quietFallbackRung": {
          "enum": [
            "none",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "fallbackAssetId": {
          "type": "string"
        }
      },
      "description": "MOTIF-06: every static final-state motif placement names its carrier"
    },
    "staticMotifPlacements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/staticMotifPlacement"
      }
    }
  }
}
