    "motionMoment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "job",
        "beat",
        "variant",
        "hostSurface"
      ],
      "properties": {
        "kind": {
          "enum": [
            "dial",
            "rings",
            "layers",
            "slice",
            "cultivate",
            "logo"
          ]
        },
        "job": {
          "enum": [
            "orientation",
            "opening",
            "spatial_transition",
            "section_orientation",
            "layering",
            "quiet_divider",
            "action_closure",
            "cultural_closure",
            "handoff",
            "animated_brand_opening"
          ]
        },
        "beat": {
          "enum": [
            "opening",
            "transition",
            "closing"
          ]
        },
        "variant": {
          "enum": [
            "full",
            "quiet"
          ]
        },
        "surfaceId": {
          "type": "string"
        },
        "overlayRef": {
          "type": "string"
        },
        "hostSurface": {
          "type": "string",
          "pattern": "^(surface\\.canvas|surface\\.alt|surface\\.card|surface\\.raised|surface\\.soft|surface\\.blueTint|surface\\.beigeTint|brand\\.beige|brand\\.blue|atmosphere\\.ground\\.mist|atmosphere\\.measure\\.luminous|atmosphere\\.ground\\.current|atmosphere\\.measure\\.deep|surfaceAtmosphere\\.ground|surfaceAtmosphere\\.measure)(@(light|dark))?$",
          "description": "MOTIF-06 carrier id from motif-register.v0.9.4.json#/carrierPolicy/carriers; themed ids are checked per rendered theme; <id>@light|@dark paints that theme's value in both themes"
        },
        "variantDark": {
          "enum": [
            "quiet"
          ],
          "description": "MOTIF-06 theme swap: full in the light theme, quiet in the dark theme"
        },
        "hostSurfaceHex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "light": {
              "type": "string"
            },
            "dark": {
              "type": "string"
            }
          }
        },
        "measuredContrast": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "light": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}–[0-9]+\\.[0-9]{2}$"
            },
            "dark": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}–[0-9]+\\.[0-9]{2}$"
            }
          },
          "description": "weakest–strongest paint ratio from carrierPolicy.measured"
        },
        "contrastVerdict": {
          "enum": [
            "meaningCapable",
            "decorativeOnly",
            "invisible"
          ]
        },
        "quietFallbackRung": {
          "enum": [
            "none",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "fallbackAssetId": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dial"
              }
            }
          },
          "then": {
            "properties": {
              "job": {
                "enum": [
                  "orientation",
                  "opening"
                ]
              },
              "beat": {
                "const": "opening"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rings"
              }
            }
          },
          "then": {
            "properties": {
              "job": {
                "enum": [
                  "spatial_transition",
                  "section_orientation"
                ]
              },
              "beat": {
                "const": "transition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "layers"
              }
            }
          },
          "then": {
            "properties": {
              "job": {
                "enum": [
                  "layering",
                  "quiet_divider"
                ]
              },
              "beat": {
                "const": "transition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "slice"
              }
            }
          },
          "then": {
            "properties": {
              "job": {
                "enum": [
                  "action_closure"
                ]
              },
              "beat": {
                "const": "closing"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cultivate"
              }
            }
          },
          "then": {
            "properties": {
              "job": {
                "enum": [
                  "cultural_closure",
                  "handoff"
                ]
              },
              "beat": {
                "const": "closing"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "logo"
              }
            }
          },
          "then": {
            "properties": {
              "job": {
                "enum": [
                  "animated_brand_opening"
                ]
              },
              "beat": {
                "const": "opening"
              }
            }
          }
        }
      ]
    },
    "motionMoments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/motionMoment"
      }
    },
    "staticMotifPlacement": {
