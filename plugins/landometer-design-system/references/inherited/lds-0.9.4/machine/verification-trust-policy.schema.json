{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landometer.org/design-system/0.9.4/verification-trust-policy.schema.1.0.json",
  "title": "Landometer caller-pinned verification trust policy v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "scope", "stores"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "policyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "scope": { "enum": ["package_release", "operator_external"] },
    "stores": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trustStoreId", "keys"],
        "properties": {
          "trustStoreId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
          "keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["keyId", "issuerId", "publicKeySpkiSha256"],
              "properties": {
                "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$" },
                "issuerId": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "publicKeySpkiSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
