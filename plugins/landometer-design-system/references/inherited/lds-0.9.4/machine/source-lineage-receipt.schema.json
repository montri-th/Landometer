{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landometer.org/design-system/0.9.4/source-lineage-receipt.schema.1.0.json",
  "title": "Landometer implementation source lineage receipt v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseRef",
    "receiptId",
    "artifactId",
    "artifactBuildId",
    "source",
    "process",
    "outputs",
    "executedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "releaseRef": { "const": "v0.9.4-mp1" },
    "receiptId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "artifactId": { "$ref": "#/$defs/nonEmpty" },
    "artifactBuildId": { "$ref": "#/$defs/nonEmpty" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "sha256", "mediaType"],
      "properties": {
        "role": {
          "enum": ["editable_source", "template", "export_preset", "style_map", "component_source", "other_governed_source"]
        },
        "ref": { "$ref": "#/$defs/safeRef" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processId", "tool", "toolVersion", "parametersSha256"],
      "properties": {
        "processId": { "$ref": "#/$defs/nonEmpty" },
        "tool": { "$ref": "#/$defs/nonEmpty" },
        "toolVersion": { "$ref": "#/$defs/nonEmpty" },
        "parametersSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mediaType"],
        "properties": {
          "path": { "$ref": "#/$defs/safeRef" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "mediaType": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "executedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001F]).+$"
    }
  }
}
