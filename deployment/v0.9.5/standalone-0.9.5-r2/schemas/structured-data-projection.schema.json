{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montri-th.github.io/Landometer/v0.9.5/standalone-0.9.5-r2/schemas/structured-data-projection.schema.json",
  "title": "Landometer visible-truth structured-data projection v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseRef",
    "pageKind",
    "canonicalUrl",
    "visibleTruthOnly",
    "entities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "releaseRef": {
      "const": "v0.9.5-owner.1"
    },
    "pageKind": {
      "enum": [
        "portfolio_home",
        "product_landing",
        "detail",
        "article",
        "index",
        "tool",
        "dataset",
        "search_results",
        "utility"
      ]
    },
    "canonicalUrl": {
      "$ref": "#/$defs/httpsUrl"
    },
    "visibleTruthOnly": {
      "const": true
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entityId",
          "role",
          "identityBasis",
          "types",
          "nameByLocale",
          "url",
          "claimIds"
        ],
        "properties": {
          "entityId": {
            "$ref": "#/$defs/publicIri"
          },
          "role": {
            "enum": [
              "page",
              "subject"
            ]
          },
          "identityBasis": {
            "enum": [
              "canonical_page",
              "projected_claim_entity"
            ]
          },
          "types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Organization",
                "WebSite",
                "WebPage",
                "CollectionPage",
                "ItemList",
                "Article",
                "BlogPosting",
                "Dataset",
                "DataCatalog",
                "WebApplication",
                "SoftwareApplication",
                "SearchResultsPage",
                "ContactPage",
                "CreativeWork",
                "Place",
                "Thing"
              ]
            }
          },
          "nameByLocale": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/nonEmpty"
            }
          },
          "url": {
            "$ref": "#/$defs/httpsUrl"
          },
          "claimIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmpty"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "page"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "identityBasis": {
                  "const": "canonical_page"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "subject"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "identityBasis": {
                  "const": "projected_claim_entity"
                },
                "claimIds": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "publicIri": {
      "type": "string",
      "pattern": "^(?:https://[^\\s]+|urn:[a-z0-9][a-z0-9-]*:[^\\s]+)$"
    }
  },
  "$comment": "Resolved standalone LDS 0.9.5 contract, revision standalone-0.9.5-r2. The distribution is owner-approved and unsigned; this schema is not a release attestation. Historical source identities and hashes are recorded separately."
}
