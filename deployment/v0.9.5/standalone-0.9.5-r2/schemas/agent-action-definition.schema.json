{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montri-th.github.io/Landometer/v0.9.5/standalone-0.9.5-r2/schemas/agent-action-definition.schema.json",
  "title": "Landometer immutable agent action definition v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseRef",
    "definitionId",
    "artifactId",
    "actionId",
    "allowedActorClasses",
    "productScope",
    "operation",
    "input",
    "permissionPolicy",
    "sideEffect",
    "confirmationPolicy",
    "resultSchemaRef",
    "resultSchemaSha256",
    "receiptSchemaRef",
    "receiptSchemaSha256",
    "errorBehavior",
    "recoveryPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3"
    },
    "releaseRef": {
      "const": "v0.9.5-owner.1"
    },
    "definitionId": {
      "$ref": "#/$defs/nonEmpty"
    },
    "artifactId": {
      "$ref": "#/$defs/nonEmpty"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "allowedActorClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "human_user",
          "authorized_agent"
        ]
      }
    },
    "productScope": {
      "enum": [
        "shared_landometer",
        "named_product"
      ]
    },
    "namedProduct": {
      "$ref": "#/$defs/nonEmpty"
    },
    "operation": {
      "enum": [
        "read",
        "inspect",
        "draft",
        "submit",
        "create",
        "save",
        "share",
        "download",
        "external_handoff",
        "confirm",
        "destructive"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef",
        "schemaSha256",
        "schemaId",
        "allowedClassifications"
      ],
      "properties": {
        "schemaRef": {
          "$ref": "#/$defs/safeRef"
        },
        "schemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "schemaId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "allowedClassifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          }
        }
      }
    },
    "permissionPolicy": {
      "enum": [
        "read_only",
        "confirm_before_commit",
        "owner_authorized"
      ]
    },
    "sideEffect": {
      "$ref": "#/$defs/sideEffect"
    },
    "confirmationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "mode"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "none",
            "explicit",
            "step_up"
          ]
        }
      }
    },
    "resultSchemaRef": {
      "$ref": "#/$defs/nonEmpty"
    },
    "resultSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "receiptSchemaRef": {
      "const": "https://montri-th.github.io/Landometer/v0.9.5/standalone-0.9.5-r2/schemas/agent-action-receipt.schema.json"
    },
    "receiptSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "errorBehavior": {
      "$ref": "#/$defs/nonEmpty"
    },
    "recoveryPolicy": {
      "$ref": "#/$defs/nonEmpty"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "productScope": {
            "const": "shared_landometer"
          }
        },
        "required": [
          "productScope"
        ]
      },
      "then": {
        "not": {
          "required": [
            "namedProduct"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "productScope": {
            "const": "named_product"
          }
        },
        "required": [
          "productScope"
        ]
      },
      "then": {
        "required": [
          "namedProduct"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "permissionPolicy": {
            "const": "read_only"
          }
        },
        "required": [
          "permissionPolicy"
        ]
      },
      "then": {
        "properties": {
          "sideEffect": {
            "properties": {
              "class": {
                "const": "none"
              },
              "external": {
                "const": false
              },
              "cost": {
                "const": "none"
              },
              "reversible": {
                "const": true
              }
            }
          },
          "confirmationPolicy": {
            "properties": {
              "required": {
                "const": false
              },
              "mode": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sideEffect": {
            "properties": {
              "class": {
                "const": "none"
              }
            },
            "required": [
              "class"
            ]
          }
        },
        "required": [
          "sideEffect"
        ]
      },
      "then": {
        "properties": {
          "sideEffect": {
            "properties": {
              "reversible": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sideEffect": {
            "properties": {
              "class": {
                "const": "reversible"
              }
            },
            "required": [
              "class"
            ]
          }
        },
        "required": [
          "sideEffect"
        ]
      },
      "then": {
        "properties": {
          "sideEffect": {
            "properties": {
              "reversible": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sideEffect": {
            "properties": {
              "class": {
                "enum": [
                  "irreversible",
                  "destructive"
                ]
              }
            },
            "required": [
              "class"
            ]
          }
        },
        "required": [
          "sideEffect"
        ]
      },
      "then": {
        "properties": {
          "sideEffect": {
            "properties": {
              "reversible": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sideEffect": {
            "anyOf": [
              {
                "properties": {
                  "class": {
                    "not": {
                      "const": "none"
                    }
                  }
                },
                "required": [
                  "class"
                ]
              },
              {
                "properties": {
                  "external": {
                    "const": true
                  }
                },
                "required": [
                  "external"
                ]
              },
              {
                "properties": {
                  "cost": {
                    "enum": [
                      "possible",
                      "known"
                    ]
                  }
                },
                "required": [
                  "cost"
                ]
              }
            ]
          }
        },
        "required": [
          "sideEffect"
        ]
      },
      "then": {
        "properties": {
          "permissionPolicy": {
            "enum": [
              "confirm_before_commit",
              "owner_authorized"
            ]
          },
          "confirmationPolicy": {
            "properties": {
              "required": {
                "const": true
              },
              "mode": {
                "enum": [
                  "explicit",
                  "step_up"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sideEffect": {
            "properties": {
              "class": {
                "const": "destructive"
              }
            },
            "required": [
              "class"
            ]
          }
        },
        "required": [
          "sideEffect"
        ]
      },
      "then": {
        "properties": {
          "permissionPolicy": {
            "const": "owner_authorized"
          },
          "confirmationPolicy": {
            "properties": {
              "mode": {
                "const": "step_up"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sideEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "external",
        "cost",
        "summary",
        "reversible"
      ],
      "properties": {
        "class": {
          "enum": [
            "none",
            "reversible",
            "irreversible",
            "destructive"
          ]
        },
        "external": {
          "type": "boolean"
        },
        "cost": {
          "enum": [
            "none",
            "possible",
            "known"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmpty"
        },
        "reversible": {
          "type": "boolean"
        }
      }
    }
  },
  "$comment": "Resolved standalone LDS 0.9.5 contract, revision standalone-0.9.5-r2. The distribution is owner-approved and unsigned; this schema is not a release attestation. Historical source identities and hashes are recorded separately."
}
