{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montri-th.github.io/Landometer/v0.9.5/standalone-0.9.5-r2/schemas/verification-trust-store.schema.json",
  "title": "Landometer operator-controlled verification trust store v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trustStoreId",
    "controlledBy",
    "scope",
    "keys"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "trustStoreId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "controlledBy": {
      "$ref": "#/$defs/nonEmpty"
    },
    "scope": {
      "enum": [
        "package_release",
        "operator_external"
      ]
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "issuerId",
          "algorithm",
          "publicKeySpkiPem",
          "allowedPurposes",
          "validFrom",
          "validUntil",
          "revokedAt"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$"
          },
          "issuerId": {
            "$ref": "#/$defs/nonEmpty"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "publicKeySpkiPem": {
            "type": "string",
            "pattern": "^-----BEGIN PUBLIC KEY-----\\n[A-Za-z0-9+/=\\n]+-----END PUBLIC KEY-----\\n?$"
          },
          "allowedPurposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "release_approval",
                "asset_approval",
                "disclosure_authority",
                "automated_conformance",
                "human_conformance",
                "production_conformance",
                "claim_approval",
                "claim_evidence_capture",
                "agent_authority",
                "agent_revocation",
                "agent_execution",
                "agent_confirmation",
                "source_lineage",
                "package_root",
                "promotion_snapshot"
              ]
            }
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "revokedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "$comment": "Resolved standalone LDS 0.9.5 contract, revision standalone-0.9.5-r2. The distribution is owner-approved and unsigned; this schema is not a release attestation. Historical source identities and hashes are recorded separately."
}
