{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landometer.org/design-system/0.9.4/format-kits.schema.1.4.json",
  "title": "Landometer semantic format-kit registry v1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseRef",
    "status",
    "note",
    "kits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.4"
    },
    "releaseRef": {
      "const": "v0.9.4-mp1"
    },
    "status": {
      "enum": [
        "candidate",
        "active"
      ]
    },
    "note": {
      "type": "string",
      "pattern": "\\S"
    },
    "kits": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "formatProfile",
          "targetProfileRefs",
          "roleMap",
          "requiredImplementationControls",
          "artifactProductionRequirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^kit\\."
          },
          "formatProfile": {
            "enum": [
              "web_public",
              "app_interactive",
              "document_flow",
              "pdf_fixed",
              "deck_presentation",
              "social_static"
            ]
          },
          "targetProfileRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^target\\."
            },
            "uniqueItems": true
          },
          "roleMap": {
            "type": "object",
            "minProperties": 1,
            "required": [
              "identity"
            ],
            "properties": {
              "identity": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "requiredImplementationControls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "artifactProductionRequirement": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
