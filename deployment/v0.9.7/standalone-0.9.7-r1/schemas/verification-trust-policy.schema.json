{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montri-th.github.io/Landometer/v0.9.7/standalone-0.9.7-r1/schemas/verification-trust-policy.schema.json",
  "title": "Landometer caller-pinned verification trust policy v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "scope",
    "stores"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "policyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "scope": {
      "enum": [
        "package_release",
        "operator_external"
      ]
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trustStoreId",
          "keys"
        ],
        "properties": {
          "trustStoreId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "keyId",
                "issuerId",
                "publicKeySpkiSha256"
              ],
              "properties": {
                "keyId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$"
                },
                "issuerId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "publicKeySpkiSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Resolved standalone LDS 0.9.7 contract, revision standalone-0.9.7-r1. The distribution is owner-approved and unsigned; this schema is not a release attestation. Historical source identities and hashes are recorded separately."
}
