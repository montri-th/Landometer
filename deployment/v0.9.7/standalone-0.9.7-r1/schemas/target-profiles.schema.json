{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montri-th.github.io/Landometer/v0.9.7/standalone-0.9.7-r1/schemas/target-profiles.schema.json",
  "title": "Landometer target profile registry v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseRef",
    "status",
    "unknownTargetBehavior",
    "extensionRegistry",
    "socialStaticScope",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3"
    },
    "releaseRef": {
      "const": "v0.9.7-owner.1"
    },
    "status": {
      "enum": [
        "candidate",
        "active"
      ]
    },
    "unknownTargetBehavior": {
      "const": "block"
    },
    "extensionRegistry": {
      "type": "null"
    },
    "socialStaticScope": {
      "const": "square_1080_and_og_1200x630"
    },
    "profiles": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "formatProfile",
          "runtime",
          "unit",
          "canvas",
          "safeArea",
          "grid",
          "typeAdapter",
          "requiredFixtures",
          "fixtureCriteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^target\\."
          },
          "formatProfile": {
            "enum": [
              "web_public",
              "app_interactive",
              "document_flow",
              "pdf_fixed",
              "deck_presentation",
              "social_static"
            ]
          },
          "runtime": {
            "enum": [
              "browser",
              "native",
              "static"
            ]
          },
          "unit": {
            "enum": [
              "css_px",
              "platform_dp",
              "mm_pt",
              "px_pt",
              "px"
            ]
          },
          "canvas": {
            "type": "object"
          },
          "safeArea": {},
          "grid": {
            "type": "object"
          },
          "typeAdapter": {},
          "minimumDiscreteTarget": {
            "type": "number",
            "minimum": 44
          },
          "export": {
            "type": "object"
          },
          "requiredFixtures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "fixtureCriteria": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "recognisers": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$comment": "Resolved standalone LDS 0.9.7 contract, revision standalone-0.9.7-r1. The distribution is owner-approved and unsigned; this schema is not a release attestation. Historical source identities and hashes are recorded separately."
}
